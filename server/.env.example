PORT=4000
DATABASE_URL=postgres://uniassist:uniassist@localhost:5432/uniassist
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173

# AI — leave blank to run in offline mode (local hashing embeddings + extractive answers)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# RAG tuning
RAG_TOP_K=6
RAG_MIN_SCORE=0.30
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
